@model ContosoUniversity.Models.Student

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Student</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-3">
            Last Name:
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.LastName)
        </dd>

        <dt class = "col-sm-3">
            First + Middle Name:
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.FirstMidName)
        </dd>

        <dt class = "col-sm-3">
            Enrollment Date:
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.EnrollmentDate)
        </dd>
    </dl>
</div>
<div>
    <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@Model.ID">Edit</a> |
    <a class="btn btn-secondary btn-sm" asp-action="Index">Back to List</a>
</div>
